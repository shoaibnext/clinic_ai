APP_NAME=Clinic AI Receptionist API
APP_ENV=development
APP_DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=change-this-in-development
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# Database
# PostgreSQL + pgvector for deployment, SQLite for local dev.
#   docker compose -f docker/docker-compose.yml up -d
#   DATABASE_URL=postgresql+psycopg://clinic_user:clinic_password@localhost:5432/clinic_ai
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./clinicai.db

# ---------------------------------------------------------------------------
# LLM provider: "azure" | "openai" | "groq"
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Azure OpenAI (production per build plan Step 5.1)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# OpenAI-compatible endpoint (Groq free tier works too)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Groq (free tier) — get key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — OpenAI-compatible aggregator (https://openrouter.ai/keys).
# Pick any model slug from https://openrouter.ai/models (the :free suffix = free tier).
# NOTE: OpenRouter has NO embeddings API — leave EMBEDDING_PROVIDER empty and the
# app falls back to a local hashing embedder so RAG works with zero extra keys.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---------------------------------------------------------------------------
# Embeddings (RAG ingestion + retrieval)
#   - "openai" or "azure": remote embeddings (needs the matching key)
#   - "" (empty): local deterministic hashing embedder (no key required)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account id (for reference/status; not required by the webhook)
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
# App Secret from the Meta app dashboard (Settings -> Basic). When set, the
# webhook REQUIRES a valid X-Hub-Signature-256 header on every POST and rejects
# invalid ones with 403. Required for production.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
